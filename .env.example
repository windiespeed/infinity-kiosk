# Copy this file to .env and fill in real values. Never commit .env.

# Port and address for the local server. 127.0.0.1 = only this computer can reach it.
# Use 0.0.0.0 later if staff should reach the admin dashboard over the museum network.
PORT=5050
HOST=127.0.0.1

# Admin PIN hash. Generate with:  npm run hash-pin -- 482913
# If this is blank, the development PIN is 1234 (never leave it blank on the kiosk).
ADMIN_PIN_HASH=
