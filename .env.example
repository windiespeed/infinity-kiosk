# Copy this file to .env and fill in real values. Never commit .env.

# Port and address for the local server. 127.0.0.1 = only this computer can reach it.
# Use 0.0.0.0 later if staff should reach the admin dashboard over the museum network.
PORT=5050
HOST=127.0.0.1

# Admin PIN hash. Generate with:  npm run hash-pin -- 482913
# If this is blank, the development PIN is 1234 (never leave it blank on the kiosk).
ADMIN_PIN_HASH=

# Where Google Drive for desktop syncs the team's shared Media folder (for npm run media:pull).
# Windows example: G:\My Drive\Media    Mac example: /Users/you/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Media
# Leave blank to let the script look in the usual places.
MEDIA_DRIVE_DIR=
