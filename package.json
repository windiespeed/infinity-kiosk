{
  "name": "infinity-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,app -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "dev:host": "concurrently -n server,app -c blue,magenta \"node --watch server/index.js\" \"vite --host\"",
    "build": "vite build",
    "prebuild": "npm run check:contrast && npm run check:content",
    "start": "node server/index.js",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:content": "node scripts/check-content.mjs",
    "hash-pin": "node scripts/hash-pin.mjs",
    "make-stars": "node scripts/make-starfield.mjs",
    "media:pull": "node scripts/media-pull.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "node scripts/android-run.mjs",
    "android:dev": "node scripts/android-run.mjs --live"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
